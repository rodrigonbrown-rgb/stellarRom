; crew face: static rules (faced/faced_exec/faced_service are declared by the ROM policy or by faceport_sepolicy.py)
(type crew_samsungface_service)
(roletype object_r crew_samsungface_service)
(typeattributeset service_manager_type (crew_samsungface_service))
(typepermissive faced)
(allow init faced_exec (file (read getattr map execute open)))
(allow init faced (process (transition siginh rlimitinh)))
(dontaudit init faced (process (noatsecure)))
(allow faced faced_exec (file (read getattr map execute open entrypoint)))
(allow faced faced_service (service_manager (add find)))
(allow servicemanager faced (binder (call transfer)))
(allow servicemanager faced (dir (search)))
(allow servicemanager faced (file (read open)))
(allow servicemanager faced (process (getattr)))
(allow hwservicemanager faced (binder (call transfer)))
(allow hwservicemanager faced (dir (search)))
(allow hwservicemanager faced (file (read open)))
(allow hwservicemanager faced (process (getattr)))
(allow system_app crew_samsungface_service (service_manager (add find)))
(allow appdomain crew_samsungface_service (service_manager (find)))
(allow system_app faced_service (service_manager (find)))
(allow system_app faced (binder (call transfer)))
(allow system_app faced (fd (use)))
(allow faced system_app (binder (call transfer)))
(allow appdomain system_app (binder (call transfer)))
(allow system_app appdomain (binder (call transfer)))
(allow system_app cameraserver_service (service_manager (find)))
(allow system_app cameraserver (binder (call transfer)))
(allow system_app cameraserver (fd (use)))
(allow cameraserver system_app (binder (call transfer)))
(allow cameraserver system_app (fd (use)))
(allow cameraserver faced (binder (call transfer)))
(allow cameraserver faced (fd (use)))
