# crew: debug-only boot watchdog (target/beyond2lte/patches/zz_crew_bootwd).
# Started at early-init so it is already running when init blocks in an
# exec_start / wait_for_prop: from then on init runs no further actions, but it
# still services property sets, so the script's sys.powerctl reboot works.
service crew_bootwd /system/bin/sh /system/bin/crew_bootwd.sh
    user root
    group root system log readproc
    seclabel u:r:crew_bootwd:s0
    oneshot
    disabled

on early-init
    start crew_bootwd
